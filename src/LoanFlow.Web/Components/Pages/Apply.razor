@page "/apply"

@rendermode InteractiveServer

@using LoanFlow.Web.Components.Models

@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider
@inject ILoanApplicationRepository Repository

<PageTitle>Apply for a loan</PageTitle>

<h1>Apply for a loan</h1>

<div class="alert alert-secondary">Step 1: the application form goes here.</div>
<EditForm Model="form" OnValidSubmit="SubmitAsync">
    <label>
        name
        <InputText @bind-Value="form.ApplicantName" />
    </label>
    <label>
        email
    <InputText @bind-Value="form.Email" />
    </label>
    <label>
        amount
        <InputNumber @bind-Value="form.Amount" />
    </label>
    <label>
        term
    <InputNumber @bind-Value="form.TermMonths" />
    </label>
    <label>
        income
    <InputNumber @bind-Value="form.MonthlyIncome" />
    </label>
    <label>
        expense
    <InputNumber @bind-Value="form.MonthlyExpenses" />
    </label>
    <DataAnnotationsValidator />
    <ValidationSummary />
    <button disabled="@isSaving" type="submit">Submit</button>
</EditForm>

@code{
    private ApplicationForm form = new();
    private bool isSaving;
    private async Task SubmitAsync()
    {
        if (isSaving) return;
        isSaving = true;
        var application = LoanApplication.Submit(
            applicantName: form.ApplicantName,
            email: form.Email,
            amount: form.Amount,
            termMonths: form.TermMonths,
            monthlyIncome: form.MonthlyIncome,
            monthlyExpenses: form.MonthlyExpenses,
            utcNow: TimeProvider.GetUtcNow().UtcDateTime);
        await Repository.InsertAsync(application);
        NavigationManager.NavigateTo($"/applications/{application.Id}");
    }
}
