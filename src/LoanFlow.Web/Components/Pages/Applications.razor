@page "/applications"

@attribute [StreamRendering]


@inject ILoanApplicationRepository LoanApplicationRepository

<PageTitle>Applications</PageTitle>

<h1>Applications</h1>

@if (applications is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Amount
                </th>
                <th>
                    Status
                </th>
                <th>
                    Submitted (UTC)
                </th>
            </tr>
        </thead>
        @foreach (var application in applications)
        {
            <tr>
                <td><a href="/applications/@application.Id"> @application.ApplicantName</a></td>
                <td>@application.Amount</td>
                <td>@application.Status</td>
                <td>@application.SubmittedAtUtc</td>

            </tr>
        }
    </table>
}

@code
{
    private IReadOnlyList<LoanApplication>? applications;
    protected override async Task OnInitializedAsync()
    {
        applications = await LoanApplicationRepository.ListRecentAsync(50);

    }
}

