{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mongo": {
    "DatabaseName": "loanflow"
  },
  "RabbitMq": {
    "Exchange": "loan.events",
    "ClientName": "loanflow-worker"
  },
  "CreditPolicy": {
    "RejectBelowScore": 580,
    "ManualReviewBelowScore": 660,
    "MaxDebtToIncomeRatio": 0.45,
    "MaxAmount": 500000,
    "OfferLifetime": "00:02:00"
  },
  "FakeCreditBureau": {
    "FailureRate": 0.2,
    "MaxLatencyMs": 1500
  }
}
