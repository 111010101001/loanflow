# Copy this file to .env (same folder as docker-compose.yml). .env is git-ignored.

# Y = you accept the license terms for the Service Bus emulator and SQL Server Linux
# (the emulator's storage backend). Read them first:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
#   https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA=N

# Password for SQL Server's sa account. SQL Server hosts the emulator's storage and
# LoanFlow's ledger database, and is published on localhost:14330. It refuses to start
# with a weak password: at least 8 characters, with three of: uppercase, lowercase,
# digits, symbols. Use the same password in the ledger connection string (README, step 0),
# and avoid ; and " in it, since those have special meaning in connection strings.
MSSQL_SA_PASSWORD=
